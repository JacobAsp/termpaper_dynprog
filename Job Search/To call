# We make the gain-loss function
def u(c, r, eta, lmbda):        # returns the utility of current consumption + the gain_loss parameter

    gainloss = np.where(
        c > r,
        eta * (np.log(c) - np.log(r)),
        eta * lmbda * (np.log(c) - np.log(r))
    )

    return np.log(c) + gainloss

        